##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as bash or
#       ksh, you may want to invoke the shell explicitly.
#       Example: $ bash gradlew
#
#   (2) The Java Virtual Machine's default charset may not handle all Unicode
#       characters in filenames, especially on Windows. For this reason, you
#       should use the Java system property file.encoding when invoking the
#       JVM. See https://docs.oracle.com/javase/tutorial/i18n/resbundle/propfile.html
#       for more details.
#
#   Specify the JVM arguments for the JVM in the GRADLE_OPTS environment variable.
#   See https://gradle.org/docs/current/userguide/build_environment.html#configuring_jvm_memory for more details.
#   If you are behind an HTTP proxy, set the GRADLE_OPTS or JAVA_OPTS variable
#   for proxy settings. Example:
#
#       $ export GRADLE_OPTS="-DhttpProxyHost=myProxyHost -DhttpProxyPort=myProxyPort"
#       $ export JAVA_OPTS="-Dhttp.proxyHost=myProxyHost -Dhttp.proxyPort=myProxyPort"
#
#   For macOS users (also see https://yadm.io/integration/gradle/):
#       $ export JAVA_HOME=$(/usr/libexec/java_home)
#
###############################################################################

if [ "$(uname)" = "Darwin" ] && ! type readlink > /dev/null; then
    # macOS Fallback
    [ -L "$0" ] && DIR="$( cd "$( dirname "$0" )" && pwd -L)" || DIR="$( cd "$( dirname "$0" )" && pwd)"
else
    SCRIPT="$0"
    [ -L "$SCRIPT" ] && SCRIPT="$(readlink "$SCRIPT")"
    DIR="$( cd "$( dirname "$SCRIPT" )" && pwd )"
fi
cd "$DIR" || exit

if [ ! -d gradle/wrapper ]; then
    echo "Gradle wrapper not found in gradle/wrapper directory"
    exit 1
fi

if [ ! -f gradle/wrapper/gradle-wrapper.jar ]; then
    echo "gradle-wrapper.jar not found. Downloading..."
    mkdir -p gradle/wrapper
    JAR_FILE="gradle/wrapper/gradle-wrapper.jar"

    # Create a simple downloader
    if command -v curl > /dev/null 2>&1; then
        curl -L "https://services.gradle.org/distributions/gradle-8.1.1-all.zip" -o /tmp/gradle-wrapper.zip
        unzip -q /tmp/gradle-wrapper.zip -d /tmp/
        cp /tmp/gradle-8.1.1/lib/plugins/gradle-core-8.1.1.jar "$JAR_FILE"
        rm -rf /tmp/gradle-wrapper.zip /tmp/gradle-8.1.1
    else
        echo "curl is required to download gradle wrapper"
        exit 1
    fi
fi

# Determine the Java command to use
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
    fi
else
    JAVACMD="java"
fi

if ! command -v "$JAVACMD" > /dev/null 2>&1 ; then
    die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH."
fi

cygwin=false
msys=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$( find gradle/wrapper -name "*.jar" | tr '\n' ':' )

need_properties_file=true
[ -f gradle/wrapper/gradle-wrapper.properties ] && need_properties_file=false

if $need_properties_file; then
    echo "gradle-wrapper.properties not found"
    exit 1
fi

exec "$JAVACMD" \
  -Dorg.gradle.appname="$APP_BASE_NAME" \
  -Dorg.gradle.launcher.nohup=true \
  -classpath "$CLASSPATH" \
  org.gradle.launcher.GradleMain \
  "$@"
